# Preserve byte hashes of the frozen CSV exports, whose writer uses CRLF.
docs/measurements/**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Runtime logs are retained verbatim, including the simulator's whitespace.
docs/results/**/*.log -text -whitespace
# Renderer fixtures keep byte hashes.
docs/results/**/*.usda -text -whitespace
# Keep generated evidence identifiable in GitHub review; reports remain visible.
docs/results/**/*.json linguist-generated=true
docs/results/**/*.log linguist-generated=true
